# Application
APP_NAME=DevDocs AI
ENVIRONMENT=development

# Frontend (SvelteKit) — open this origin in the browser (prefer localhost, not mixed hosts)
FRONTEND_URL=http://localhost:5173
# Used by the browser; must match the host/port you pass to uvicorn
PUBLIC_API_URL=http://localhost:8001

# Backend (FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# Explicit CORS allow-list (comma-separated). In development the API also allows
# http://localhost:<any> and http://127.0.0.1:<any> via regex — see docs/ENV.md
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL) — must match docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://devdocs:change_me@localhost:5432/devdocs

# Auth (server-side session cookies; see docs/DECISIONS.md)
SESSION_COOKIE_NAME=devdocs_session
SESSION_EXPIRE_MINUTES=10080
# Keep false for local http:// ; set true only behind HTTPS
COOKIE_SECURE=false
# Required to sign OAuth state and encrypt GitHub tokens at rest
SECRET_KEY=replace-with-a-long-random-string

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8001/auth/github/callback
# GITHUB_OAUTH_SCOPES=read:user repo

# LLM / embeddings (post–Week 1; leave blank for now)
# OPENAI_API_KEY=
# EMBEDDING_MODEL=
# CHAT_MODEL=
