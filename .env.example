# Application
APP_NAME=DevDocs AI
ENVIRONMENT=development

# Frontend (SvelteKit)
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8001

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://devdocs:change_me@localhost:5432/devdocs

# Auth (server-side session cookies; see docs/DECISIONS.md)
SESSION_COOKIE_NAME=devdocs_session
SESSION_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# GitHub OAuth (fill in when implementing)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# LLM / embeddings (post–Week 1; leave blank for now)
# OPENAI_API_KEY=
# EMBEDDING_MODEL=
# CHAT_MODEL=
